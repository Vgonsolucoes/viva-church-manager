# App Viva Church (Mobile)
# Copie para .env antes de rodar `npm run start`
#
# Ambientes (3 perfis EAS: development / preview / production)
#
# 1) Desenvolvimento (dev server, Expo Go ou Dev Client)
EXPO_PUBLIC_APP_ENV=development
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000   # Android emulator local backend
# EXPO_PUBLIC_API_URL=http://localhost:3000   # iOS simulator local backend
EXPO_PUBLIC_API_URL=https://viva-church-manager-app.54myeq.easypanel.host

# 2) Preview (homologação APK / TestFlight internal)
# EXPO_PUBLIC_APP_ENV=preview
# EXPO_PUBLIC_API_URL=https://viva-church-manager-app.54myeq.easypanel.host

# 3) Production (Google Play / App Store)
# EXPO_PUBLIC_APP_ENV=production
# EXPO_PUBLIC_API_URL=https://viva-church-manager-app.54myeq.easypanel.host

